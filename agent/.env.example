# Copy this file to .env and fill in your own key. NEVER commit .env.
#
# The agent layer is model-agnostic (Google ADK + LiteLLM). Pick ONE provider:

# --- Option A: Anthropic Claude (default for this project) -----------------
ANTHROPIC_API_KEY=
# LiteLLM model id used by all three agents:
AGENT_MODEL=anthropic/claude-sonnet-5

# --- Option B: Google Gemini ------------------------------------------------
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# AGENT_MODEL=gemini-2.5-flash
